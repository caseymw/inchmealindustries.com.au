# Strapi API token (Settings -> API Tokens in the running admin UI,
# "Read-only" scope is enough since this script never writes to Strapi).
STRAPI_API_TOKEN=

# Fine-grained GitHub PAT scoped to just this repo, Contents: Read and
# write only (docs/ARCHITECTURE.md Section 5.1). Only npm run push /
# publish need this - export and build-check don't.
GITHUB_TOKEN=

GIT_COMMIT_NAME=Inchmeal Publisher
GIT_COMMIT_EMAIL=publisher@inchmealindustries.com.au
