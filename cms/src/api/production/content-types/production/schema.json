{
  "kind": "collectionType",
  "collectionName": "productions",
  "info": {
    "singularName": "production",
    "pluralName": "productions",
    "displayName": "Production",
    "description": "A past theatre production Inchmeal contributed to"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "tagline": {
      "type": "string"
    },
    "synopsis": {
      "type": "richtext"
    },
    "credits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.credit"
    },
    "ourRole": {
      "type": "richtext"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "year": {
      "type": "integer"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
